{
  "name": "ipv4fuzz",
  "target": "linux/amd64",
  "http": "127.0.0.1:56741",
  "workdir": "@WS@/work/syz-workdir",
  "kernel_obj": "@WS@/work/kernel",
  "image": "@WS@/work/img/trixie.img",
  "sshkey": "@WS@/work/img/trixie.id_rsa",
  "syzkaller": "@WS@/syzkaller",
  "sandbox": "@SANDBOX@",
  "procs": 2,
  "type": "qemu",
  "cover": true,
  "enable_syscalls": [
    "socket*",
    "setsockopt*",
    "getsockopt*",
    "sendmsg*",
    "recvmsg*",
    "sendto*",
    "recvfrom*",
    "sendmmsg*",
    "recvmmsg*",
    "connect*",
    "bind*",
    "listen*",
    "accept*",
    "shutdown*",
    "ioctl$sock*",
    "ioctl$SIOC*",
    "syz_init_net_socket*",
    "syz_emit_ethernet",
    "syz_extract_tcp_res",
    "read",
    "write",
    "close",
    "mmap",
    "munmap",
    "poll",
    "fcntl*",
    "dup*",
    "pipe*",
    "epoll_*",
    "eventfd*",
    "timerfd*",
    "nanosleep",
    "sched_yield",
    "getpid",
    "gettid",
    "unshare",
    "setrlimit",
    "prctl",
    "madvise"
  ],
  "vm": {
    "count": 1,
    "kernel": "@WS@/work/kernel/bzImage",
    "cpu": 2,
    "mem": 3072,
    "network_device": "virtio-net-pci",
    "cmdline": "root=/dev/sda console=ttyS0 oops=panic panic=1 net.ifnames=0",
    "qemu_args": "-enable-kvm -cpu host"
  }
}